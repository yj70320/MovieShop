SELECT [m2].[Id], [m2].[BackdropUrl], [m2].[Budget], [m2].[CreatedBy], [m2].[CreatedDate], [m2].[ImdbUrl], [m2].[OriginalLanguage], [m2].[Overview], [m2].[PosterUrl], [m2].[Price], [m2].[ReleaseDate], [m2].[Revenue], [m2].[Runtime], [m2].[Tagline], [m2].[Title], [m2].[TmdbUrl], [m2].[UpdatedBy], [m2].[UpdatedDate], [s].[MovieId], [s].[GenreId], [s].[Id], [s].[Name], [s0].[MovieId], [s0].[CastId], [s0].[Character], [s0].[Id], [s0].[Gender], [s0].[Name], [s0].[ProfilePath], [s0].[TmdbUrl], [t].[Id], [t].[MovieId], [t].[Name], [t].[TrailerUrl]
FROM (
    SELECT TOP(1) [m].[Id], [m].[BackdropUrl], [m].[Budget], [m].[CreatedBy], [m].[CreatedDate], [m].[ImdbUrl], [m].[OriginalLanguage], [m].[Overview], [m].[PosterUrl], [m].[Price], [m].[ReleaseDate], [m].[Revenue], [m].[Runtime], [m].[Tagline], [m].[Title], [m].[TmdbUrl], [m].[UpdatedBy], [m].[UpdatedDate]
    FROM [Movie] AS [m]
    WHERE [m].[Id] = @__id_0
) AS [m2]
LEFT JOIN (
    SELECT [m0].[MovieId], [m0].[GenreId], [g].[Id], [g].[Name]
    FROM [MovieGenre] AS [m0]
    INNER JOIN [Genre] AS [g] ON [m0].[GenreId] = [g].[Id]
) AS [s] ON [m2].[Id] = [s].[MovieId]
LEFT JOIN (
    SELECT [m1].[MovieId], [m1].[CastId], [m1].[Character], [c].[Id], [c].[Gender], [c].[Name], [c].[ProfilePath], [c].[TmdbUrl]
    FROM [MovieCast] AS [m1]
    INNER JOIN [Cast] AS [c] ON [m1].[CastId] = [c].[Id]
) AS [s0] ON [m2].[Id] = [s0].[MovieId]
LEFT JOIN [Trailer] AS [t] ON [m2].[Id] = [t].[MovieId]
ORDER BY [m2].[Id], [s].[MovieId], [s].[GenreId], [s].[Id], [s0].[MovieId], [s0].[CastId], [s0].[Character], [s0].[Id]
